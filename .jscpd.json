{
  "threshold": 5,
  "reporters": ["console"],
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/.turbo/**",
    "**/*.d.ts",
    "**/*.test.ts",
    "**/tests/**",
    "**/pnpm-lock.yaml"
  ],
  "format": ["typescript", "javascript", "tsx", "jsx", "css"],
  "minLines": 5,
  "minTokens": 50,
  "mode": "mild",
  "blame": false
}
