# PostgreSQL Database Connection URL (e.g., local Postgres, Supabase, Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codexel?schema=public"

# Redis Connection URL (for BullMQ background job processing)
REDIS_URL="redis://localhost:6379"

# Web App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"

# AI Assistant API Keys (Optional - Free Gemini or OpenAI)
# Free Gemini Key: https://aistudio.google.com/ (Select "Get API key" - 100% Free Tier)
GEMINI_API_KEY=""

# OpenAI Key (Optional): https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# AI Rate Limiting & Quota Safeguards (Protects against billing spikes & API key exhaustion)
# Per-IP request limits:
AI_RATE_LIMIT_PER_MINUTE="6"       # Max AI queries per IP in 1 minute
AI_RATE_LIMIT_PER_DAY="30"         # Max AI queries per IP in 24 hours
AI_COOLDOWN_SECONDS="3"            # Minimum seconds between consecutive queries per IP

# Global platform safety caps (Gemini Free Tier is 15 RPM / 1500 RPD):
AI_GLOBAL_RATE_LIMIT_PER_MINUTE="12" # Global minute cap across all visitors
AI_GLOBAL_RATE_LIMIT_PER_DAY="1200"   # Global daily cap across all visitors

# Token & Prompt safety guards:
AI_MAX_QUERY_LENGTH="500"          # Maximum characters per user question
AI_MAX_FACTS_LENGTH="12000"        # Max markdown facts context sent to model
GEMINI_MAX_OUTPUT_TOKENS="1024"    # Max tokens Gemini can emit per answer

