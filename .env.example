# PostgreSQL Database Connection URL (e.g., local Postgres, Supabase, Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codexel?schema=public"

# Redis Connection URL (for BullMQ background job processing)
REDIS_URL="redis://localhost:6379"

# Web App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"

# AI Assistant API Keys (Optional - Free Gemini or OpenAI)
# Free Gemini Key: https://aistudio.google.com/ (Select "Get API key" - 100% Free Tier)
GEMINI_API_KEY=""

# OpenAI Key (Optional): https://platform.openai.com/api-keys
OPENAI_API_KEY=""
